# SatQuery AI - Environment Configuration
# Copy this file to .env and replace placeholder values with real secrets.
# NEVER commit .env to Git.

# AI service
GEMINI_API_KEY=your_gemini_api_key_here

# Production application URL
APP_URL=http://localhost:3000

# -----------------------------
# Inference workers
# -----------------------------

GEOCHAT_WORKER_URL=http://127.0.0.1:8088
GEOCHAT_MODEL_ID=MBZUAI/geochat-7B
GEOCHAT_DEVICE=cuda
GEOCHAT_LOAD_MODE=4bit
GEOCHAT_MAX_NEW_TOKENS=512
GEOCHAT_TEMPERATURE=0.2
GEOCHAT_TIMEOUT_MS=15000

# Shared Node -> Python worker authentication
# Set real values in .env / deployment environment.
GEOCHAT_AUTH_KEY=your_geochat_worker_secret
GROUNDING_AUTH_KEY=your_grounding_worker_secret

# -----------------------------
# Application security
# -----------------------------

# Protects /api/* routes except /api/health
SATQUERY_API_KEY=your_satquery_api_key

# Exact allowed frontend origins, comma-separated
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Production transport settings
ENFORCE_HTTPS=false
TRUST_PROXY=

# -----------------------------
# Rate limiting
# -----------------------------

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=300

RATE_LIMIT_INFERENCE_MAX=60
RATE_LIMIT_UPLOAD_MAX=120
RATE_LIMIT_EXTERNAL_MAX=60

RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_AUTH_WINDOW_MS=300000

# -----------------------------
# Optional specialist workers
# -----------------------------

GROUNDING_WORKER_URL=http://127.0.0.1:8002
SEGMENTATION_WORKER_URL=http://127.0.0.1:8003
CHANGE_ANALYSIS_WORKER_URL=http://127.0.0.1:8004
OPTICAL_SAR_WORKER_URL=http://127.0.0.1:8005